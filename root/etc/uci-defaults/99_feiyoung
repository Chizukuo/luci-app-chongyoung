#!/bin/sh

# v2 配置迁移：字段重命名 + 清理废弃项
# password_seed -> password（旧 6 位原始密码即新静态密码）
if uci -q get feiyoung.general.password_seed >/dev/null; then
    OLD_SEED=$(uci -q get feiyoung.general.password_seed)
    if [ -z "$(uci -q get feiyoung.general.password)" ]; then
        uci set feiyoung.general.password="$OLD_SEED"
    fi
    uci delete feiyoung.general.password_seed
fi

# 删除废弃的认证参数（旧 XML 接口用）
for attr in system prefix AidcAuthAttr3 AidcAuthAttr4 AidcAuthAttr5 AidcAuthAttr6 AidcAuthAttr8 AidcAuthAttr15 AidcAuthAttr22 AidcAuthAttr23; do
    uci -q delete feiyoung.general.$attr
done

# 删除废弃的每日密码列表
uci -q delete feiyoung.daily

# 补充新字段默认值
[ -z "$(uci -q get feiyoung.general.passType)" ] && uci set feiyoung.general.passType='1'
[ -z "$(uci -q get feiyoung.general.gateway)" ] && uci set feiyoung.general.gateway='http://58.53.199.144:8001'
[ -z "$(uci -q get feiyoung.general.load_balancing)" ] && uci set feiyoung.general.load_balancing='1'

# 合并 opkg 备份的配置文件（如果存在）
if [ -f /etc/config/feiyoung-opkg ]; then
    mv /etc/config/feiyoung-opkg /etc/config/feiyoung_backup

    OLD_ENABLED=$(uci -q get feiyoung_backup.general.enabled)
    OLD_USERNAME=$(uci -q get feiyoung_backup.general.username)
    OLD_PWD=$(uci -q get feiyoung_backup.general.password)
    [ -z "$OLD_PWD" ] && OLD_PWD=$(uci -q get feiyoung_backup.general.password_seed)

    [ -n "$OLD_ENABLED" ] && uci set feiyoung.general.enabled="$OLD_ENABLED"
    [ -n "$OLD_USERNAME" ] && uci set feiyoung.general.username="$OLD_USERNAME"
    [ -n "$OLD_PWD" ] && uci set feiyoung.general.password="$OLD_PWD"

    rm -f /etc/config/feiyoung_backup
fi

# v2.2 配置迁移：若 general 中包含旧版 username，且没有 account 节，自动转换为首个 account
if [ -n "$(uci -q get feiyoung.general.username)" ] && [ -z "$(uci -q show feiyoung | grep '=account')" ]; then
    SEC=$(uci add feiyoung account)
    uci set feiyoung."$SEC".enabled="$(uci -q get feiyoung.general.enabled || echo 1)"
    uci set feiyoung."$SEC".client_type="pc"
    uci set feiyoung."$SEC".username="$(uci -q get feiyoung.general.username)"
    uci set feiyoung."$SEC".password="$(uci -q get feiyoung.general.password)"
    uci -q delete feiyoung.general.username
    uci -q delete feiyoung.general.password
fi

uci commit feiyoung

# 删除废弃的每日密码计算脚本
rm -f /usr/share/feiyoung/calc_pwd.lua

# 确保脚本有执行权限
chmod +x /usr/bin/feiyoung.sh 2>/dev/null

# 重载 rpcd 以应用新的 ACL 权限（忽略错误）
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload 2>/dev/null

# 将 Feiyoung 自定义回调脚本加入 sysupgrade 备份列表以防刷机/升级丢失
if [ -f /etc/sysupgrade.conf ] && ! grep -q -F "/etc/feiyoung.user" /etc/sysupgrade.conf; then
    echo "/etc/feiyoung.user" >> /etc/sysupgrade.conf
fi

# 启用并启动服务
/etc/init.d/feiyoung enable 2>/dev/null
/etc/init.d/feiyoung restart 2>/dev/null

exit 0
